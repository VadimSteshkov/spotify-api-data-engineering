# ==========================================
# AVD — Docker-only environment configuration
# ==========================================

# -----------------------------
# App identity (per teammate)
# -----------------------------
APP_PREFIX=avd

# -----------------------------
# Spotify API credentials
# -----------------------------
CLIENT_ID=5ec8fa1fa37e498082582a23212724ca
CLIENT_SECRET=5684ac189992491e9df9d90c9ee3592e
USERNAME=31fbaymkqi7ugbop2dhwywwjpmya
REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional market override for "dominant artist" Top10 (ISO country code)
MARKET_OVERRIDE=RO
PRODUCER_POLL_SEC=60

# Spotipy (keep consistent with above)
SPOTIPY_CLIENT_ID=5ec8fa1fa37e498082582a23212724ca
SPOTIPY_CLIENT_SECRET=5684ac189992491e9df9d90c9ee3592e
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# -----------------------------
# Debug / feature flags
# -----------------------------
DEBUG=true
KAFKA_ENABLED=true

# -----------------------------
# Kafka cluster (inside Docker)
# -----------------------------
# Internal broker (used by all containers)
KAFKA_BOOTSTRAP=kafka:19092

# Topics derived from APP_PREFIX
KAFKA_TOPICS=${APP_PREFIX}_recent_events,${APP_PREFIX}_artist_market_top_tracks

# Topic routing for semantic handling (optional)
KAFKA_TOPIC_ROUTES=${APP_PREFIX}_recent_events:events,${APP_PREFIX}_artist_market_top_tracks:top10

# -----------------------------
# MongoDB connection (inside Docker)
# -----------------------------
MONGO_URL=mongodb://root:example@mongo:27017/?authSource=admin
MONGO_DB=spotify_db

# Collections for consumer and Streamlit
MONGO_COLL_EVENTS=${APP_PREFIX}_recent_events
MONGO_COLL_TOP10=${APP_PREFIX}_artist_market_top_tracks

# Namespace for generic topic-to-collection mapping
GENERIC_COLL_NAMESPACE=${APP_PREFIX}__topic__

# -----------------------------
# Producer entrypoint
# -----------------------------
PRODUCER_ENTRY=avd_producer

# -----------------------------
# Spark Structured Streaming
# -----------------------------
# Kafka topics to stream (leave empty to use KAFKA_TOPICS)
SPARK_KAFKA_TOPICS=

# Micro-batch trigger (seconds)
SPARK_TRIGGER_SECS=10

# Watermark for late data (minutes)
#SPARK_WATERMARK_MIN=5

# Aggregation output collections
SPARK_COLL_EVENTS=
SPARK_COLL_RAW=

# Aggregation mode:
#   - top_artists : Top-N by artist_name
#   - top_tracks  : Top-N by track_name
#   - feature_avg : Mean value of SPARK_FEATURE grouped by SPARK_GROUP
#SPARK_MODE=top_tracks
#SPARK_MODE=top_artists

# Limit for Top-N queries
SPARK_TOPN=10

# Feature-based aggregation parameters (only for feature_avg)
#SPARK_FEATURE=track_duration_ms
#SPARK_GROUP=market_used

# Required Spark Kafka connector packages
SPARK_PACKAGES=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1,org.apache.kafka:kafka-clients:3.5.2

# -----------------------------
# Streamlit app
# -----------------------------
# Optional: override port (default 8501)
PORT=8501

TEAM_CONFIG_SPARK=spark/team_config.yaml


SPOTIPY_REFRESH_TOKEN=AQASlGLaenCrmlvRwxiO6JbI-dArOqsT-iN-mTKfzfsfgxf6JH3eHLWf4yss-g_3yrG6E81OhUoC7WAI6NkJGCCOF92MaCtyPGnL5eilIhVoHdctZPsDEkELgykDNYWi_RI
