# ==========================================
# Example .env (copy to .env and fill YOUR values)
# Works out-of-the-box in Docker; adjust if you run locally.
# ==========================================

# -----------------------------
# App identity (per teammate)
# -----------------------------
# Short prefix to namespace Kafka topics & Mongo collections.
APP_PREFIX=yourprefix

# -----------------------------
# Spotify API credentials (required)
# -----------------------------
# Create a Spotify App and paste your credentials here.
CLIENT_ID=__REPLACE_ME__
CLIENT_SECRET=__REPLACE_ME__
USERNAME=__REPLACE_ME__                 # your Spotify username
REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional market override for "dominant artist" Top10 (ISO country code, e.g., AT/DE/RO)
MARKET_OVERRIDE=

# Spotipy aliases (keep consistent with the above)
SPOTIPY_CLIENT_ID=${CLIENT_ID}
SPOTIPY_CLIENT_SECRET=${CLIENT_SECRET}
SPOTIPY_REDIRECT_URI=${REDIRECT_URI}

# If you already have a refresh token (recommended in Docker), put it here:
# Tip: run auth flow locally once to obtain it, then reuse in Docker.
SPOTIPY_REFRESH_TOKEN=

# -----------------------------
# RAPID API credentials (required)
# -----------------------------
RAPID_API_KEY=__REPLACE_ME__
RAPIDAPI_REQUESTS_PER_SECOND=0.5
RAPIDAPI_RETRY_ATTEMPTS=3

# -----------------------------
# SETTINGS
# -----------------------------

# How often to run analysis (seconds)
# 3600 = 1 hour (default)
# 300 = 5 minutes (for testing)
ANALYSIS_INTERVAL=3600

# Which genres to bridge
BRIDGE_SOURCE=techno
BRIDGE_TARGET=house

# -----------------------------
# Debug / feature flags
# -----------------------------
DEBUG=true
KAFKA_ENABLED=true

# -----------------------------
# Kafka cluster
# -----------------------------
# Inside Docker use kafka:19092 (container-to-container)
# If running producer locally (outside Docker), you might need localhost:9092
KAFKA_BOOTSTRAP=kafka:19092

# Topics derived from APP_PREFIX (do not change unless you know why)
KAFKA_TOPICS=alex_playlist_analysis,avd_recent_events,avd_artist_market_top_tracks,vadim_tracks,vadim_playlists,vadim_weekly_stats,vadim_monthly_stats,gilian_genre_danceability,gilian_genre_bridges

# Optional semantic routing map (topicName:label)
KAFKA_TOPIC_ROUTES=${APP_PREFIX}_recent_events:events,${APP_PREFIX}_artist_market_top_tracks:top10

# -----------------------------
# MongoDB connection
# -----------------------------
# Inside Docker use the service name "mongo"
# If running locally, you may need: mongodb://root:example@localhost:27017/?authSource=admin
MONGO_URL=mongodb://root:example@mongo:27017/?authSource=admin
MONGO_DB=spotify_db

# Collections commonly used by the app
MONGO_COLL_EVENTS=${APP_PREFIX}_recent_events
MONGO_COLL_TOP10=${APP_PREFIX}_artist_market_top_tracks

# Namespace used by generic topic->collection mapper
GENERIC_COLL_NAMESPACE=${APP_PREFIX}__topic__

# -----------------------------
# Producer entrypoint
# -----------------------------
# Module name (without .py) that the producer uses as entrypoint
PRODUCER_ENTRY=${APP_PREFIX}_producer

# -----------------------------
# Spark Structured Streaming
# -----------------------------
# Kafka topics to stream; leave empty to default to KAFKA_TOPICS
SPARK_KAFKA_TOPICS=

# Micro-batch trigger (seconds)
SPARK_TRIGGER_SECS=10

# Watermark & windowing (strings supported by Spark, e.g., "10 minutes", "2 hours")
SPARK_WATERMARK=2 hours
SPARK_WINDOW_SIZE=10 minutes
SPARK_WINDOW_SLIDE=1 minute

# Aggregation mode (ENV overrides team_config.yaml):
#   - top_artists        : Top-N by artist_name (per window)
#   - top_tracks         : Top-N by track_name (per window)
#   - top_tracks_grouped : Top-N by track per group column (e.g., market_used)
#   - feature_avg        : Mean of SPARK_FEATURE grouped by SPARK_GROUP (per window)
SPARK_MODE=top_tracks
SPARK_TOPN=10

# Feature-mode parameters (used by feature_avg and *_grouped modes)
# e.g., SPARK_FEATURE=track_duration_ms   SPARK_GROUP=market_used
SPARK_FEATURE=energy
SPARK_GROUP=market_used

# Required Spark Kafka connector packages
SPARK_PACKAGES=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1,org.apache.kafka:kafka-clients:3.5.2

# -----------------------------
# Streamlit app
# -----------------------------
# Optional: override port (default 8501)
PORT=8501

# Path to team config (YAML); ENV takes precedence over YAML
TEAM_CONFIG_SPARK=spark/team_config.yaml
PRODUCER_POLL_SEC=60
