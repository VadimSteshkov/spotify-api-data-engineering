##############################################
# GLOBAL SETTINGS
##############################################

# Prefix used to namespace all your topics and Mongo collections.
# Example: if APP_PREFIX=alex, Mongo collections will be saved as:
# alex__topic__<topic_name>
APP_PREFIX=alex


##############################################
# SPOTIFY API CREDENTIALS
##############################################
# Only required if your producer fetches data from Spotify.
# If your use case does not use Spotify, you can leave these values as placeholders.

CLIENT_ID=<ALEX_SPOTIFY_CLIENT_ID>
CLIENT_SECRET=<ALEX_SPOTIFY_CLIENT_SECRET>
USERNAME=<ALEX_SPOTIFY_USERNAME>

# Redirect URI used for Spotify OAuth (default for Spotipy)
REDIRECT_URI=http://127.0.0.1:8888/callback

# Compatibility with Spotipy environment variable names
SPOTIPY_CLIENT_ID=<ALEX_SPOTIFY_CLIENT_ID>
SPOTIPY_CLIENT_SECRET=<ALEX_SPOTIFY_CLIENT_SECRET>
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback


##############################################
# DEBUG & FEATURE FLAGS
##############################################
# DEBUG=true  → enables verbose logging for troubleshooting
# DEBUG=false → cleaner console output
DEBUG=true

# Enable or disable Kafka integration.
# If false, data will only be printed to stdout (not sent to Kafka).
KAFKA_ENABLED=true


##############################################
# KAFKA CONFIGURATION
##############################################
# Kafka broker accessible from the host.
KAFKA_BOOTSTRAP=localhost:9092

# Comma-separated list of Kafka topics used by this user/producer.
# You can define ANY number of topics for your own pipelines.
# Example: KAFKA_TOPICS=alex_metrics,alex_events,alex_activity
KAFKA_TOPICS=alex_metrics,alex_events

# Optional JSON-style routing rule if you want to map topics
# to specific MongoDB collections manually.
# Example: KAFKA_TOPIC_ROUTES=alex_metrics:metrics_collection,alex_events:events_collection
# Leave empty to use automatic naming via GENERIC_COLL_NAMESPACE.
KAFKA_TOPIC_ROUTES=


##############################################
# MONGODB SETTINGS
##############################################
# Default Mongo connection (Docker MongoDB uses root/example)
MONGO_URL=mongodb://root:example@localhost:27017/?authSource=admin

# MongoDB database name
MONGO_DB=spotify_db

# Optional: specific collections for legacy or fixed pipelines
# If you don't use "events" or "top10", just leave these empty.
MONGO_COLL_EVENTS=
MONGO_COLL_TOP10=

# Namespace prefix for all auto-created Mongo collections
# (use your APP_PREFIX for consistent naming)
GENERIC_COLL_NAMESPACE=alex__topic__


##############################################
# PRODUCER ENTRYPOINT
##############################################
# Path to your Python producer file.
# This script defines how data is collected and sent to Kafka.
# Each team member can create their own producer file in src/producers/
# Example: src/producers/alex_producer.py or src/producers/vadim_producer.py
PRODUCER_ENTRY=src/producers/alex_producer.py

# =========================
# Spark Streaming (per-topic schemas + RAW fallback)
# =========================
# If empty, Spark will reuse KAFKA_TOPICS
SPARK_KAFKA_TOPICS=
SPARK_TRIGGER_SECS=10
SPARK_WATERMARK_MIN=5

# Where Spark writes in Mongo (defaults are safe)
SPARK_COLL_EVENTS=
SPARK_COLL_RAW=

